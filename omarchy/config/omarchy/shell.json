{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.apps"
        }
      ],
      "centerBegin": [],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.weather"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "omacalc",
      "omawrite",
      "X",
      "YouTube"
    ]
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.agents",
    "omarchy.background",
    "omarchy.clipboard",
    "omarchy.disk-speedtest",
    "omarchy.dock",
    "omarchy.dropbox",
    "omarchy.elsewhen",
    "omarchy.emojis",
    "omarchy.idle",
    "omarchy.indicators",
    "omarchy.keyboard-layout",
    "omarchy.monitor",
    "omarchy.nightlight",
    "omarchy.reminders",
    "omarchy.remote-session",
    "omarchy.speedtest",
    "omarchy.system-update",
    "omarchy.tailscale",
    "omarchy.wifiqr"
  ]
}
