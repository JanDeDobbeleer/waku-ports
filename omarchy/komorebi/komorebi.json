{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "mouse_follows_focus": false,
  "default_workspace_padding": 3,
  "default_container_padding": 5,
  "border": true,
  "border_implementation": "Komorebi",
  "border_width": 2,
  "border_offset": 0,
  "border_style": "Square",
  "border_colours": {
    "single": "#89b4fa",
    "stack": "#89b4fa",
    "monocle": "#89b4fa",
    "floating": "#f9e2af",
    "unfocused": "#585b70",
    "unfocused_locked": "#f6b6ab"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "BSP"
        },
        {
          "name": "2",
          "layout": "BSP"
        },
        {
          "name": "3",
          "layout": "BSP"
        },
        {
          "name": "4",
          "layout": "BSP"
        },
        {
          "name": "5",
          "layout": "BSP"
        },
        {
          "name": "6",
          "layout": "BSP"
        },
        {
          "name": "7",
          "layout": "BSP"
        }
      ]
    }
  ]
}
