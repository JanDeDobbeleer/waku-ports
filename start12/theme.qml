// Theme of the built-in widgets the taskbar uses (Taskbar, Tray, Volume, Notifications).
import waku

ThemeSpec {
    text: "#ffffff"
    surface: "#00000000"
    accent: "#4cc2ff"
    warn: "#ff9d3b"
    good: "#2fb8a0"
    caution: "#e0b84c"

    fill: "#14ffffff"
    fillHover: "#1fffffff"
    fillActive: "#26ffffff"
    fillUsed: "#1fffffff"
    fillEmpty: "#0fffffff"

    popupSurface: "#f21b273b"
    popupBorder: "#26ffffff"

    fontFamily: "Segoe UI Variable Text"
    fontSize: 12
    smallFontSize: 11
    pillHeight: 32
    radius: 6
    padding: 8
    spacing: 6
}
